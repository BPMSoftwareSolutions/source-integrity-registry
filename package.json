{
  "name": "@deterministic-solutions/source-integrity-registry",
  "version": "0.1.0",
  "description": "Deterministic governance of physical-to-logical source bindings. Proves the contract by which source bodies may be governed, before governing them.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sir": "./dist/cli/sir.js"
  },
  "files": [
    "dist",
    "contracts"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generate:types": "tsx scripts/generate-types.ts",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "generate:remediation-index": "tsx scripts/generate-remediation-index.ts",
    "create:remediation-checkpoint": "tsx scripts/create-remediation-checkpoint.ts",
    "check:generated": "tsx scripts/check-generated.ts",
    "check:remediation-index": "tsx scripts/check-remediation-index.ts",
    "check:remediation-history": "tsx scripts/check-remediation-history.ts",
    "check:documentation-snapshots": "tsx scripts/check-documentation-snapshots.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prove:core": "pnpm typecheck && pnpm test && pnpm check:generated && pnpm check:remediation-index && pnpm check:remediation-history && pnpm check:documentation-snapshots && tsx scripts/prove-fresh-build.ts",
    "prove": "pnpm prove:core && tsx scripts/prove-packed-consumer.ts",
    "prepack": "pnpm prove:core"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.0",
    "@cucumber/messages": "^34.2.0",
    "@types/node": "^20.14.0",
    "json-schema-to-typescript": "^15.0.4",
    "marked": "^18.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
